{
  "name": "fig",
  "private": true,
  "version": "0.1.0",
  "description": "A Claude Code plugin for strangler-fig migrations of legacy backends: route by route, with recorded parity and a searchable index of the old code.",
  "author": "Artur Bruno",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "legacy": "node legacy/server.js",
    "service": "tsx service/src/main.ts",
    "edge": "tsx edge/src/main.ts",
    "record": "tsx parity/src/cli/record.ts",
    "parity": "tsx parity/src/cli/parity.ts",
    "verify": "tsx parity/src/cli/verify.ts",
    "report": "tsx parity/src/cli/report.ts",
    "index:build": "tsx index/src/cli/build.ts",
    "index:query": "tsx index/src/cli/query.ts",
    "index:eval": "tsx index/src/cli/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "approve": "node scripts/approve.mjs",
    "hooks:dry-run": "node scripts/hooks-dry-run.mjs",
    "demo:shadow": "node scripts/shadow-demo.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "express": "^4.22.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
